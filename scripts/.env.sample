RESOURCE_GROUP_NAME=YOUR_RESOURCE_GROUP_NAME # <<PLACEHOLDER>>
RESOURCE_GROUP_LOCATION=YOUR_RESOURCE_GROUP_LOCATION # <<PLACEHOLDER>>
